#AWS CONFIG
AWS_REGION=us-east-1
AWS_ACCESS_KEY=AKIA**************
AWS_SECRET_KEY=Uj4***************************
 
#Embedding Model - 1024 Dimensions
BEDROCK_MODEL_ID_TITAN=amazon.titan-embed-text-v2:0

# Chat Model (Final Response)
BEDROCK_MODEL_ID_CHAT=arn:aws:bedrock:us-east-1:498398192936:inference-profile/us.meta.llama3-3-70b-instruct-v1:0

# SQL Generation Model
BEDROCK_MODEL_ID_SQL=arn:aws:bedrock:us-east-1:498398192936:inference-profile/us.meta.llama3-3-70b-instruct-v1:0

#Classification Model
BEDROCK_MODEL_ID_CLASSIFICATION=arn:aws:bedrock:us-east-1:498398192936:inference-profile/us.meta.llama3-3-70b-instruct-v1:0

# Groundedness/correctness judge model (used only by evals/) - recommend a
# different model family than the ones above (e.g. a Claude Bedrock inference
# profile) to avoid self-grading bias. Falls back to BEDROCK_MODEL_ID_CHAT if unset.
BEDROCK_MODEL_ID_JUDGE=arn:aws:bedrock:us-east-1:498398192936:inference-profile/us.anthropic.claude-3-5-sonnet-20241022-v2:0

#Database Connection Details
# If DB_SECRET_NAME is provided, credentials will be fetched from AWS Secrets Manager
# DB_SECRET_NAME=my-database-secret
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# ---------------- Knowledge base location ----------------
# Database holding the few-shot examples (shared across all tenants).
KNOWLEDGEBASE_DATABASE_NAME=maintwiz
# Schema within that database.
KNOWLEDGEBASE_SCHEMA_NAME=ai
# Table of few-shot examples. A bare name is qualified with
# KNOWLEDGEBASE_SCHEMA_NAME; a "schema.table" value is used as-is.
#   knowlegebaseexamples_new - corrected copy (5 broken queries fixed, LIMIT
#                              added to 175 SELECTs, reference tables repaired)
#   knowledge_base_examples  - the original; set this to roll back
KNOWLEDGEBASE_TABLE=knowlegebaseexamples_new

# Schema in each TENANT database holding the data the generated SQL reads.
DATA_SCHEMA=ai
# Schema holding users_m, read for "my data" style questions.
USER_DETAILS_SCHEMA=public

# All five above are interpolated into SQL (a schema or table name cannot be a
# bind parameter), so each is validated as a plain identifier at startup:
# letters, digits, underscores and dots only. A malformed value stops the app
# from starting rather than reaching the database.

# Phoenix API Key
PHOENIX_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6*************

# Phoenix container auth (used by the phoenix service in docker-compose.yml)
PHOENIX_SECRET=your_phoenix_secret
PHOENIX_ADMIN_PASSWORD=your_phoenix_admin_password

#pheonix trace dependencies
# Spans are exported over gRPC, so this must be Phoenix's OTLP gRPC receiver:
# port 4317, host:port only, NO URL path. Port 6006 is the UI and 4318 is the
# OTLP HTTP receiver - either will make every export fail silently.
COLLECTOR_ENDPOINT=http://arize-phoenix:4317
COLLECTOR_PROJECT_NAME=async-mw-copilot-sql-bot-bedrock